# Copy to .env and fill in. Never commit .env.

# 1. Create a bot with @BotFather in Telegram (/newbot) and paste its token.
TELEGRAM_BOT_TOKEN=

# 2. Your numeric Telegram user ID (message @userinfobot to get it). Comma-separate several.
#    The bot ignores everyone else, so strangers can't use it or spend your API credits.
ALLOWED_TELEGRAM_USER_IDS=

# 3. Optional: enables the AI tutor (ask questions, go deeper, graded answers, fresh quizzes,
#    mock interviews, and auto-written drafts of unwritten lessons). Leave empty to use only the
#    authored course.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Higher means more thorough answers at more cost.
TUTOR_EFFORT=medium
# The language the AI tutor replies in (authored lessons are in English).
TUTOR_LANGUAGE=English

# Where progress (SQLite) and generated lessons are stored.
DATA_DIR=./data
# Local hour (0-23) for a daily "continue where you left off" reminder after a day away; -1 disables.
NUDGE_HOUR=19

# Audio versions of lessons (🎧 under steps, and /listen). "auto" uses the macOS built-in voice when
# it is available; "none" turns audio off. List installed voices with:  say -v '?'
# Better voices are a free download on macOS: System Settings > Accessibility > Spoken Content >
# System Voice > Manage Voices (look for "Premium" or "Enhanced"). Compare them with tts_bench/.
TTS_BACKEND=auto
TTS_VOICE=Daniel
TTS_RATE=175
